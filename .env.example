# Copy to .env for reference, or export these directly. Every value is optional;
# the defaults below are what the service uses when the variable is unset.
#
# The app reads plain environment variables, so these work equally with
# `export`, `docker run -e`, a Compose `environment:` block, or k8s env.

# Path to the trained model artifact.
# Default: <repo root>/app/model/model.pkl
MODEL_PATH=

# Number of features the model expects. Requests carrying any other number of
# features are rejected with 422 at the API boundary.
FEATURE_DIM=10

# Micro-batching. Larger batches amortise per-inference overhead; a wider window
# fills batches more fully at the cost of added latency for early arrivals.
BATCH_MAX_SIZE=32
BATCH_WINDOW_MS=5

# Bounded queue. Overload becomes visible as 503s rather than unbounded memory
# growth. Backpressure sheds load once depth crosses MAX_SIZE * WATERMARK_RATIO.
QUEUE_MAX_SIZE=2000
QUEUE_HIGH_WATERMARK_RATIO=0.8

# Hard per-request deadline in milliseconds. Breaching it returns 504.
REQUEST_TIMEOUT_MS=100
